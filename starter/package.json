{
  "name": "car-delivery-control-room-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "attachments:seed": "tsx scripts/seed-attachments.ts",
    "attachments:smoke": "tsx scripts/smoke-attachments.ts",
    "smoke": "tsx scripts/smoke.ts",
    "ring:background": "tsx --require ./scripts/ring-shim.cjs scripts/background.ts",
    "ring:run": "tsx --require ./scripts/ring-shim.cjs scripts/ring-run.ts",
    "ring:check": "tsx --require ./scripts/ring-shim.cjs lib/triage/triage.check.ts && tsx lib/agent/sim/calls.check.ts",
    "eval:reviewer": "tsx scripts/eval-reviewer.ts",
    "eval:learned": "tsx --require ./scripts/ring-shim.cjs scripts/eval-learned.ts",
    "eval:ring": "tsx --require ./scripts/ring-shim.cjs scripts/eval-ring.ts",
    "ring:record": "tsx --require ./scripts/ring-shim.cjs scripts/ring-record.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "posthog-js": "^1.438.21",
    "posthog-node": "^5.57.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
