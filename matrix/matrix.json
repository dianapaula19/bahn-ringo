{
  "name": "Ringo Control Room",
  "slug": "bahn-ring",
  "listingTrust": "first_party",
  "description": "Bahn car delivery control room with the Ringo pickup-readiness agent. Synthetic data, simulated calls.",
  "category": "productivity",
  "icon": "bahn-ring",
  "author": "hackathon-04",
  "version": "0.1.0",
  "runtime": "node",
  "runtimeVersion": "^1.0.0",
  "scope": "personal",
  "build": {
    "install": "true",
    "command": "true",
    "output": ".",
    "timeout": 60
  },
  "serve": {
    "start": "cd ../../projects/bahn-ring/starter && exec node --env-file-if-exists=.env.local ../matrix/prefix-proxy.mjs /apps/bahn-ring",
    "healthCheck": "/",
    "startTimeout": 60,
    "idleShutdown": 900
  },
  "resources": {
    "memoryMb": 768,
    "cpuShares": 512,
    "maxFileHandles": 256
  }
}
